{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Next and Playwright supply framework entrypoints. Scripts also have supported
  // manual CLI entrypoints; library code is analysed transitively from all of them.
  "entry": [
    "workers/edge/worker.mjs",
    "open-next{,.preview}.config.ts",
    "playwright.optimizer.config.ts", // Manual optimizer smoke-test entrypoint.
    "scripts/{audits,build,content,deploy,imports,palettes,particles,sync}/**/*.{ts,mjs,cjs}",
    "scripts/tests/test-*.{ts,mjs}",
    "tests/browser/**/*.spec.ts",
    // Browser script loaded by the palette review tool's HTML.
    "scripts/palettes/palette-review/review.js",
    "scripts/tests/fixtures/previous-release/refresh.mjs"
  ],
  "project": [
    "workers/edge/*.{mjs,mts}",
    "{components,lib,pages,scripts,tests}/**/*.{js,jsx,ts,tsx,mts,mjs,cjs}",
    "*.{js,ts,mjs}"
  ],
  "ignoreExportsUsedInFile": true,
  // TypeScript resolves these declarations with their .mjs twins implicitly;
  // their runtime export names are checked separately rather than deleting them.
  "ignoreFiles": ["**/*.d.mts"],
  // System tools used by offline fixtures and manual WebP importers.
  "ignoreBinaries": ["jq", "cwebp"],
  // Cloudflare provides this Worker runtime built-in; it is not an npm dependency.
  "ignoreDependencies": ["cloudflare"],
  "exclude": ["enumMembers", "duplicates"],
  // Modules shared with arkpedia-data's importer (test-importer-copies.ts holds them equal), whose
  // exports the import's own scripts use.
  "ignoreIssues": { "scripts/lib/youtube-uploads.mjs": ["exports"] },
  "next": true,
  "eslint": ["eslint.config.mjs"],
  "playwright": true
}
