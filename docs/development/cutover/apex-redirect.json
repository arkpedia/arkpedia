{
  "ref": "arkpedia_apex_to_www",
  "description": "Preserve Arkpedia's canonical www hostname, path and query",
  "expression": "http.host eq \"arkpedia.net\"",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 308,
      "target_url": {
        "expression": "concat(\"https://www.arkpedia.net\", http.request.uri.path)"
      },
      "preserve_query_string": true
    }
  },
  "enabled": true
}
