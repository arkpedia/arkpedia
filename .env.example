# Reference pages and the closed poll results need no database or local secrets.
# Optional: protect write access to development-only tools.
# DEV_CONSOLE_PASSCODE=
# Optional: authenticate the release-refresh API when running it yourself.
# ARKPEDIA_RELEASE_REFRESH_SECRET=
# Runtime content defaults to the public live pointer. Dev deployments set dev-live.
# ARKPEDIA_CONTENT_CHANNEL=live
# Optional: override the HTTPS runtime-content origin for a controlled environment.
# ARKPEDIA_CONTENT_URL=

# Server-only community feeds: never use NEXT_PUBLIC_ for these credentials.
# Twitch Developer application (client-credentials flow; no viewer login needed).
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# YouTube Data API v3: community live status and Discover's daily cached likes.
# Restrict the key to YouTube Data API v3 in Google Cloud.
# YOUTUBE_API_KEY=
