{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "arkpedia-assets",
  "account_id": "1ff51c10571eaa9934bc451e1bfdb361",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "assets.arkpedia.net", "custom_domain": true }],
  "r2_buckets": [{ "binding": "PUBLIC_ASSETS", "bucket_name": "arkpedia-public-assets" }],
  "observability": { "enabled": true }
}
