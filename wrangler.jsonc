{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arkpedia",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // The page cache (open-next.config.ts). The bucket must exist before a deploy:
  // `npx wrangler r2 bucket create arkpedia-opennext-cache`, or R2 > Create bucket in the dashboard.
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "arkpedia-opennext-cache" }],
  // The Worker calling itself: res.revalidate (the release refresh) and the revalidation queue
  // re-render a page this way. The service must be this Worker's own name.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "arkpedia" }],
  // The revalidation queue, a Durable Object class the OpenNext worker exports.
  "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }]
}
