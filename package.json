{
  "name": "arkpedia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "postbuild": "npm run check:deployment-traces && npm run check:client-chunks",
    "deploy:vercel": "bash scripts/deploy/vercel-production.sh",
    "release:status": "node scripts/deploy/release-status.mjs",
    "typecheck": "tsc --noEmit",
    "test:operators": "tsx --test scripts/tests/test-operator-details.ts",
    "test:skin-artwork": "tsx --test scripts/tests/test-skin-artwork.ts",
    "voices:refresh": "node scripts/build/build-operator-voices.mjs",
    "lyrics:refresh": "node scripts/sync/sync-lyrics.mjs",
    "albums:refresh": "node scripts/sync/sync-albums.mjs",
    "endfield-albums:refresh": "node scripts/sync/sync-endfield-albums.mjs",
    "official-videos:refresh": "tsx scripts/sync/sync-official-videos.mjs",
    "test:operator-voices": "tsx --test scripts/tests/test-operator-voices.ts",
    "test:operator-guesser": "tsx --test scripts/tests/test-operator-guesser.ts",
    "lint": "eslint pages components lib",
    "test:minigames": "tsx --test scripts/tests/test-stage-guesser.ts scripts/tests/test-recruitment-guesser.ts scripts/tests/test-operator-guesser.ts scripts/palettes/test-color-palette.ts",
    "test:recruitment-guesser": "tsx --test scripts/tests/test-recruitment-guesser.ts",
    "test:color-palette": "tsx --test scripts/palettes/test-color-palette.ts",
    "palettes:refresh": "python3 scripts/palettes/build-color-palettes.py --revisions data/assets/revisions.json",
    "palettes:review": "python3 scripts/palettes/review-color-palettes.py",
    "start": "next start",
    "test:pull-plan": "tsx --test scripts/tests/test-pull-plan.ts scripts/tests/test-pull-probability.ts",
    "audit:pulls": "tsx scripts/audits/audit-pulls.ts",
    "pulls:refresh": "tsx scripts/build/build-pull-sources.ts && node scripts/build/build-pull-first-clears.mjs && node scripts/build/build-free-rewards.mjs",
    "test:music-guesser": "tsx --test scripts/tests/test-music-guesser.ts",
    "audit:music-guesser": "tsx scripts/audits/audit-music-guesser.ts",
    "audit:base": "node scripts/audits/audit-base-skills.mjs",
    "test:base-optimizer": "tsx --test scripts/tests/test-base-optimizer.ts",
    "test:techniques": "tsx --test scripts/tests/test-technique-regressions.ts",
    "audit:import": "npx tsx scripts/audits/audit-import-formats.ts",
    "audit:styles": "node scripts/audits/audit-styles.mjs",
    "audit:build": "npx tsx scripts/audits/audit-build.ts",
    "stages:refresh": "bash scripts/sync/refresh-stage-data.sh",
    "events:sync": "node scripts/sync/sync-event-windows.mjs",
    "prebuild": "node scripts/build/write-build-info.mjs && node scripts/build/adopt-release-asset-pins.mjs && node scripts/audits/check-skin-catalogue.mjs && NODE_ENV=production npm run generate:public",
    "predev": "NODE_ENV=production npm run generate:public",
    "test": "env -u ARKPEDIA_RELEASE_BRANCH -u ARKPEDIA_DATA_BRANCH -u ARKPEDIA_CONTENT_POINTER -u ARKPEDIA_CONTENT_CHANNEL tsx --test scripts/tests/test-*.ts scripts/tests/test-*.mjs scripts/palettes/test-color-palette.ts scripts/content/*.test.mjs",
    "check:styles": "node scripts/audits/check-unstyled-classes.mjs --strict",
    "check:assets": "node scripts/audits/check-external-assets.cjs && node scripts/audits/check-stage-previews.mjs && npx tsx scripts/audits/check-icon-coverage.ts",
    "check:assets:release": "node scripts/audits/check-external-assets.cjs && node scripts/audits/check-stage-previews.mjs && npx tsx scripts/audits/check-icon-coverage.ts --quarantine",
    "check:payload-budgets": "tsx scripts/audits/check-payload-budgets.ts",
    "check:published-assets": "node scripts/audits/check-published-assets.mjs && node scripts/audits/check-voice-clips.mjs",
    "check:published-assets:release": "node scripts/audits/check-published-assets.mjs --quarantine && node scripts/audits/check-voice-clips.mjs --quarantine",
    "check:deployment-traces": "node scripts/audits/check-deployment-traces.mjs",
    "check:client-chunks": "node scripts/audits/check-client-chunks.mjs",
    "assets:update": "node scripts/sync/update-asset-revisions.mjs",
    "test:browser": "playwright test",
    "content:export": "node scripts/content/export.mjs",
    "content:validate": "node scripts/content/validate-release.mjs .cache/content-export",
    "test:content-runtime": "node scripts/content/test-runtime.mjs",
    "banners:sync": "node scripts/sync/sync-recurring-banners.mjs",
    "test:banners": "node --test scripts/tests/test-recurring-banners.mjs",
    "modules:sync": "node scripts/sync/sync-module-stats.mjs",
    "test:module-stats": "node --test scripts/tests/test-module-stats.mjs",
    "test:base": "tsx --test scripts/tests/test-base-skills.ts scripts/tests/test-base-imports.mjs scripts/tests/test-base-combinations.ts scripts/tests/test-base-trading-reference.ts scripts/tests/test-base-cross-room-boundaries.ts scripts/tests/test-base-combination-properties.ts",
    "audit:base-combinations": "tsx scripts/audits/audit-base-combinations.ts",
    "selectors:ratings": "tsx scripts/imports/import-selector-ratings.ts",
    "test:py": "node scripts/tests/run-python-tests.mjs",
    "audit:unused": "knip",
    "check:local": "npm run typecheck && npm test && npm run test:py && npm run lint -- --max-warnings 15 && npm run lint:scripts && npm run check:styles && npm run audit:styles && npm run audit:unused",
    "generate:public": "node scripts/build/build-enemy-details.mjs && npx tsx scripts/build/build-stage-details.ts && npx tsx scripts/build/build-stage-guesser.ts && npx tsx scripts/build/build-operator-search.ts && npx tsx scripts/build/build-music-catalogue.ts && npx tsx scripts/build/build-site-search.ts && npx tsx scripts/build/build-selector-catalogue.ts",
    "lint:scripts": "eslint scripts",
    "cf:staging:check": "node scripts/deploy/cloudflare-staging.mjs check",
    "cf:staging:build": "node scripts/deploy/cloudflare-staging.mjs build",
    "cf:staging:deploy": "node scripts/deploy/cloudflare-staging.mjs deploy"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@vercel/analytics": "^2.0.1",
    "fflate": "^0.8.3",
    "libcurl.js": "0.7.4",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.984.0",
    "@cloudflare/workers-types": "5.20261024.1",
    "@eslint/js": "9.39.5",
    "@opennextjs/cloudflare": "1.20.12",
    "@playwright/test": "^1.63.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^20.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "globals": "14.0.0",
    "js-yaml": "^4.3.2",
    "knip": "6.41.0",
    "opencc-js": "1.4.2",
    "pinyin-pro": "3.29.4",
    "pngjs": "^7.0.0",
    "tesseract.js": "7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "typescript-eslint": "8.72.0",
    "wanakana": "5.3.1",
    "wrangler": "4.151.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    },
    "miniflare@5.20261019.1-beta": {
      "undici": "7.30.1"
    }
  }
}
