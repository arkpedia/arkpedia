{
  "name": "arkpedia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "npm run check:deployment-traces && npm run check:client-chunks",
    "deploy:vercel": "bash scripts/deploy/vercel-production.sh",
    "typecheck": "tsc --noEmit",
    "test:operators": "tsx --test scripts/tests/test-operator-details.ts",
    "test:skin-artwork": "tsx --test scripts/tests/test-skin-artwork.ts",
    "voices:refresh": "node scripts/build/build-operator-voices.mjs",
    "lyrics:refresh": "node scripts/sync/sync-lyrics.mjs",
    "albums:refresh": "node scripts/sync/sync-albums.mjs",
    "test:operator-voices": "tsx --test scripts/tests/test-operator-voices.ts",
    "test:operator-guesser": "tsx --test scripts/tests/test-operator-guesser.ts",
    "lint": "next lint",
    "test:minigames": "tsx --test scripts/tests/test-stage-guesser.ts scripts/tests/test-recruitment-guesser.ts scripts/tests/test-operator-guesser.ts scripts/palettes/test-color-palette.ts",
    "test:recruitment-guesser": "tsx --test scripts/tests/test-recruitment-guesser.ts",
    "test:color-palette": "tsx --test scripts/palettes/test-color-palette.ts",
    "palettes:refresh": "python3 scripts/palettes/build-color-palettes.py --revisions data/assets/revisions.json",
    "palettes:review": "python3 scripts/palettes/review-color-palettes.py",
    "start": "next start",
    "test:pull-plan": "tsx --test scripts/tests/test-pull-plan.ts scripts/tests/test-pull-probability.ts",
    "audit:pulls": "tsx scripts/audits/audit-pulls.ts",
    "pulls:refresh": "tsx scripts/build/build-pull-sources.ts && node scripts/build/build-pull-first-clears.mjs",
    "test:music-guesser": "tsx --test scripts/tests/test-music-guesser.ts",
    "audit:music-guesser": "tsx scripts/audits/audit-music-guesser.ts",
    "audit:base": "node scripts/audits/audit-base-skills.mjs",
    "test:base-optimizer": "tsx --test scripts/tests/test-base-optimizer.ts",
    "test:techniques": "tsx --test scripts/tests/test-technique-regressions.ts",
    "audit:import": "npx tsx scripts/audits/audit-import-formats.ts",
    "audit:styles": "node scripts/audits/audit-styles.mjs",
    "audit:build": "npx tsx scripts/audits/audit-build.ts",
    "stages:refresh": "bash scripts/sync/refresh-stage-data.sh",
    "events:sync": "node scripts/sync/sync-event-windows.mjs",
    "prebuild": "node scripts/build/write-build-info.mjs && node scripts/build/adopt-release-asset-pins.mjs && node scripts/audits/check-skin-catalogue.mjs && node scripts/build/build-enemy-details.mjs && npx tsx scripts/build/build-stage-details.ts && npx tsx scripts/build/build-stage-guesser.ts && npx tsx scripts/build/build-operator-search.ts && npx tsx scripts/build/build-music-catalogue.ts",
    "predev": "node scripts/build/build-enemy-details.mjs && npx tsx scripts/build/build-stage-details.ts && npx tsx scripts/build/build-stage-guesser.ts && npx tsx scripts/build/build-operator-search.ts && npx tsx scripts/build/build-music-catalogue.ts",
    "test": "tsx --test scripts/tests/test-*.ts scripts/tests/test-*.mjs scripts/palettes/test-color-palette.ts",
    "check:styles": "node scripts/audits/check-unstyled-classes.mjs --strict",
    "check:assets": "node scripts/audits/check-external-assets.cjs && node scripts/audits/check-stage-previews.mjs && npx tsx scripts/audits/check-icon-coverage.ts",
    "check:assets:release": "node scripts/audits/check-external-assets.cjs && node scripts/audits/check-stage-previews.mjs && npx tsx scripts/audits/check-icon-coverage.ts --quarantine",
    "check:payload-budgets": "tsx scripts/audits/check-payload-budgets.ts",
    "check:published-assets": "node scripts/audits/check-published-assets.mjs && node scripts/audits/check-voice-clips.mjs",
    "check:published-assets:release": "node scripts/audits/check-published-assets.mjs && node scripts/audits/check-voice-clips.mjs --quarantine",
    "check:deployment-traces": "node scripts/audits/check-deployment-traces.mjs",
    "check:client-chunks": "node scripts/audits/check-client-chunks.mjs",
    "assets:update": "node scripts/sync/update-asset-revisions.mjs",
    "test:browser": "playwright test",
    "content:export": "node scripts/content/export.mjs",
    "content:validate": "node scripts/content/validate-release.mjs .cache/content-export",
    "test:content-runtime": "node scripts/content/test-runtime.mjs",
    "banners:sync": "node scripts/sync/sync-recurring-banners.mjs",
    "test:banners": "node --test scripts/tests/test-recurring-banners.mjs",
    "modules:sync": "node scripts/sync/sync-module-stats.mjs",
    "test:module-stats": "node --test scripts/tests/test-module-stats.mjs"
  },
  "dependencies": {
    "next": "^14.2.0",
    "pg": "^8.23.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "js-yaml": "^4.3.2",
    "opencc-js": "1.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
