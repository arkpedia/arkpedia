# Next.js build output
.next/
.next-live/

# Dependencies
node_modules/

# Environment variables / secrets
.env
.env.local
.env*.local
*.log
.DS_Store
.claude/

# Compiler and tooling caches. tsconfig.tsbuildinfo is the one this repo actually
# produces; the rest are here so a future flag or a Turbopack run cannot start leaking
# a cache directory into the tree.
*.tsbuildinfo
.swc/
.turbo/
.eslintcache

# Upstream data pulled by scripts/sync/refresh-stage-data.sh for the data builds --
# 458MB of someone else's repo.
.cache/

# What each refresh stage did this run (scripts/content/run-stage.mjs). Durations differ
# every run, so it stays out of the published source (export.mjs skips ignored files);
# otherwise every day would be a new release. The run's summary and issue carry it.
data/stage-report.json

# Vercel CLI (if you ever run `vercel` locally)
.vercel/

public/lyrics
public/planner-data

# Generated dev tool: inlines a map screenshot, so it is big and not source.
scripts/ra-tracer.html

# NOT ignored, deliberately: next-env.d.ts. Next writes it on `next dev` and `next
# build`, so it looks like an artifact -- but tsconfig.json includes it, and CI runs
# `npm run typecheck` BEFORE `npm run build`. Untrack it and a fresh checkout
# typechecks without Next's ambient types, which is where the JSON imports and every
# next/image reference come from.

# Generated by the detail emitters on every build (prebuild) -- derived wholly
# from data/, so committing them checks in something that goes stale at once.
public/enemy-detail
public/stage-detail

public/stage-guesser
# The music player's queue (scripts/build/build-music-catalogue.ts): published in the
# content release, and written by prebuild/predev as the deployment's fail-safe copy.
# Ignored, so export.mjs never publishes it as a source record.
public/music-catalogue.json
# The site search's index (scripts/build/build-site-search.ts): the same arrangement as the
# music catalogue -- published in the content release, written by prebuild/predev as the
# deployment's fail-safe copy, and ignored so export.mjs never publishes it as a source record.
public/site-search.json
# Which code a build is (scripts/build/write-build-info.mjs, the first step of prebuild),
# served by the deployment for the content release gate. Ignored, so export.mjs never
# publishes it as a source record and a deploy never becomes a new release id.
public/build-info.json

# Media is published from arkpedia-skin-assets or arkpedia-image-assets. Keep
# generated/imported copies available to local tooling without allowing the
# application repository to grow another media history.
public/**/*.webp
public/**/*.png
public/**/*.jpg
public/**/*.jpeg
public/**/*.gif
public/**/*.svg
public/**/*.avif
public/**/*.ico

# Python importer caches
__pycache__/
*.py[cod]

# Local browser regression output
/test-results/
/playwright-report/

# Legacy local optimizer outputs: only .cache/optimizers is used now. Never publish
# a stale calculation as a canonical game record.
/data/optimizer-results.json
/data/optimizer-results.json.bak
/data/whole-base-optimizer-results.json
/data/whole-base-optimizer-results.json.bak

# Cloudflare Workers build output (OpenNext) and local wrangler state.
.open-next/
.wrangler/
.dev.vars
