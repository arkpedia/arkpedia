{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Dedicated staging environment. No production routes, domains, cache or database.
  "name": "arkpedia-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": { "ARKPEDIA_CONTENT_CHANNEL": "live", "ARKPEDIA_DEPLOYMENT_ROLE": "staging" },
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "arkpedia-staging-cache" }],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "arkpedia-staging" }],
  "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }]
}
